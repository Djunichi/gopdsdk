{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "gopdsdk: doctor (auto-discovery)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": ["doctor"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "gopdsdk: doctor (PLAYDATE_SDK_PATH)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": ["doctor", "--sdk", "${env:PLAYDATE_SDK_PATH}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "gopdsdk: doctor (build probes)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": ["doctor", "--probe"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "gopdsdk: simulator probe",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": ["probe", "simulator", "--sdk", "${env:PLAYDATE_SDK_PATH}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "gopdsdk: simulator acceptance",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": ["probe", "simulator", "--run", "--sdk", "${env:PLAYDATE_SDK_PATH}"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "gopdsdk: build Hello World",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": [
        "build",
        "--sdk",
        "${env:PLAYDATE_SDK_PATH}",
        "--output",
        "${workspaceFolder}/.cache/hello.pdx",
        "./examples/hello"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "gopdsdk: run Hello World",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/gopdsdk",
      "args": [
        "run",
        "--sdk",
        "${env:PLAYDATE_SDK_PATH}",
        "--output",
        "${workspaceFolder}/.cache/hello-run.pdx",
        "./examples/hello"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
