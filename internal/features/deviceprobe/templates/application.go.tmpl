func (playdateContext) DrawTextInRect(text string,x,y,width,height int,wrap sdkPlaydate.TextWrappingMode,align sdkPlaydate.TextAlignment)error{if width<=0||height<=0||wrap>sdkPlaydate.TextWrapWord||align>sdkPlaydate.TextAlignRight{return sdkPlaydate.ErrGraphicsGeometry};bridgeDrawTextInRect(unsafe.StringData(text),uintptr(len(text)),int32(x),int32(y),int32(width),int32(height),int32(wrap),int32(align));return nil}
func (playdateContext) TextHeight(font sdkPlaydate.Font,text string,width int,wrap sdkPlaydate.TextWrappingMode,tracking,leading int)(int,error){handle,err:=sdkRuntime.FontHandle(font);if err!=nil{return 0,err};if width<=0||wrap>sdkPlaydate.TextWrapWord{return 0,sdkPlaydate.ErrGraphicsGeometry};return int(bridgeTextHeight(handle,unsafe.StringData(text),uintptr(len(text)),int32(width),int32(wrap),int32(tracking),int32(leading))),nil}
func (playdateContext) Glyph(font sdkPlaydate.Font,code,next rune)(sdkPlaydate.FontGlyph,error){handle,err:=sdkRuntime.FontHandle(font);if err!=nil{return sdkPlaydate.FontGlyph{},err};var bitmap uintptr;var advance,kerning int32;if bridgeFontGlyph(handle,uint32(code),uint32(next),&bitmap,&advance,&kerning)==0{return sdkPlaydate.FontGlyph{},sdkPlaydate.ErrFontGlyph};image,err:=sdkRuntime.NewBorrowedFontBitmap(font,bitmap,bitmapDriver);if err!=nil{return sdkPlaydate.FontGlyph{},err};return sdkPlaydate.FontGlyph{Bitmap:image,Advance:int(advance),Kerning:int(kerning)},nil}

